@model RoleInput

@{
    ViewData["Title"] = "Crear rol";
}

<div class="rounded-4 shadow-sm text-white p-4 mb-4"
     style="background: linear-gradient(135deg, #1b263b 0%, #0077b6 100%);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h2 fw-bold mb-1">Crear nuevo rol</h1>
            <p class="mb-0 text-white-50">
                Define un rol personalizado y selecciona sus permisos en el catálogo y administración.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>Volver a roles
        </a>
    </div>
</div>

<partial name="_AlertsPartial" />

<form asp-action="Create" method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 shadow-sm mb-4" role="alert"></div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3" style="color: #1b263b;">
                <i class="bi bi-tag me-2 text-primary"></i>Datos generales
            </h5>
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name"
                       class="form-control rounded-3"
                       placeholder="Ej. EditorCatalogo, Soporte" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3" style="color: #1b263b;">
                <i class="bi bi-key me-2 text-primary"></i>Permisos del rol
            </h5>
            <partial name="_PermissionGroups" model="Model.SelectedPermissions" />
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #0077b6; border-color: #0077b6;">
            <i class="bi bi-check-circle me-1"></i>Crear rol
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_PermissionGroupsScripts" />
}
