@model RoleInput

@{
    ViewData["Title"] = $"Editar rol - {Model.Name}";
    var isAdminBuiltIn = Model.IsBuiltIn && string.Equals(Model.Name, AppRoles.Admin, StringComparison.OrdinalIgnoreCase);
    var permViewData = new ViewDataDictionary(ViewData)
    {
        ["LockAdminCorePermissions"] = isAdminBuiltIn
    };
}

<div class="rounded-4 shadow-sm text-white p-4 mb-4"
     style="background: linear-gradient(135deg, #1b263b 0%, #0077b6 100%);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="h2 fw-bold mb-1">Editar rol: @Model.Name</h1>
            <p class="mb-0 text-white-50">
                Actualiza la configuración y permisos asignados a este rol.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-eye me-1"></i>Ver detalles
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>
</div>

<partial name="_AlertsPartial" />

@if (Model.IsBuiltIn)
{
    <div class="alert alert-info rounded-4 shadow-sm mb-4">
        <i class="bi bi-shield-exclamation me-2"></i>
        <strong>Rol base protegido:</strong> El nombre de <strong>@Model.Name</strong> no puede modificarse ni eliminarse.
        @if (isAdminBuiltIn)
        {
            <span>Además, <strong>Admin</strong> conserva obligatoriamente <code>Roles.Manage</code> y <code>Users.Manage</code>.</span>
        }
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsBuiltIn" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 shadow-sm mb-4" role="alert"></div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3" style="color: #1b263b;">
                <i class="bi bi-tag me-2 text-primary"></i>Nombre del rol
            </h5>
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                @if (Model.IsBuiltIn)
                {
                    <input asp-for="Name" class="form-control rounded-3 bg-light" readonly="readonly" />
                    <small class="text-muted">Solo lectura para roles base del sistema.</small>
                }
                else
                {
                    <input asp-for="Name" class="form-control rounded-3" />
                }
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3" style="color: #1b263b;">
                <i class="bi bi-key me-2 text-primary"></i>Permisos del rol
            </h5>
            <partial name="_PermissionGroups" model="Model.SelectedPermissions" view-data="permViewData" />
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #0077b6; border-color: #0077b6;">
            <i class="bi bi-save me-1"></i>Guardar cambios
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_PermissionGroupsScripts" />
}
