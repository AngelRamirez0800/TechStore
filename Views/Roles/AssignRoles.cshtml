@model UserRoleAssignmentInput

@{
    ViewData["Title"] = $"Asignar roles - {Model.UserName}";
    var currentUserId = ViewBag.CurrentUserId as string;
    var isSelf = !string.IsNullOrWhiteSpace(currentUserId) &&
        string.Equals(Model.UserId, currentUserId, StringComparison.Ordinal);
    var selectedSet = (Model.SelectedRoles ?? new List<string>())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
}

<div class="rounded-4 shadow-sm text-white p-4 mb-4"
     style="background: linear-gradient(135deg, #1b263b 0%, #0077b6 100%);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge bg-light text-dark rounded-pill mb-2 px-3 py-1">
                <i class="bi bi-person-badge me-1 text-primary"></i>Asignación de Roles
            </span>
            <h1 class="h2 fw-bold mb-1">Usuario: @Model.UserName</h1>
            <p class="mb-0 text-white-50">@Model.Email</p>
        </div>
        <a asp-action="Users" class="btn btn-outline-light rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>Volver a usuarios
        </a>
    </div>
</div>

<partial name="_AlertsPartial" />

@if (isSelf)
{
    <div class="alert alert-warning rounded-4 shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Estás editando tu propia cuenta. Por seguridad, no puedes removerte el rol <strong>Admin</strong>.
    </div>
}

<form asp-action="AssignRoles" asp-route-id="@Model.UserId" method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="UserName" />
    <input type="hidden" asp-for="Email" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 shadow-sm mb-4" role="alert"></div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3" style="color: #1b263b;">
                <i class="bi bi-shield-check me-2 text-primary"></i>Roles disponibles
            </h5>

            @if (!Model.AvailableRoles.Any())
            {
                <div class="alert alert-info rounded-3 mb-0">
                    No hay roles registrados en el sistema.
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    @foreach (var roleName in Model.AvailableRoles)
                    {
                        var checkboxId = "role_" + roleName.Replace(" ", "_");
                        var isChecked = selectedSet.Contains(roleName);
                        var isBuiltIn = AppRoles.IsBuiltIn(roleName);

                        <div class="col">
                            <label class="card h-100 border rounded-3 p-3 bg-light bg-opacity-50 d-flex flex-row align-items-center gap-3"
                                   for="@checkboxId"
                                   style="cursor: pointer;">
                                <input class="form-check-input mt-0"
                                       type="checkbox"
                                       name="SelectedRoles"
                                       value="@roleName"
                                       id="@checkboxId"
                                       @(isChecked ? "checked" : null) />
                                <div>
                                    <div class="fw-semibold" style="color: #1b263b;">@roleName</div>
                                    @if (isBuiltIn)
                                    {
                                        <span class="badge rounded-pill text-white mt-1" style="background-color: #1b263b;">
                                            Rol base
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-white text-dark border rounded-pill mt-1">
                                            Personalizado
                                        </span>
                                    }
                                </div>
                            </label>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-save me-1"></i>Guardar roles
        </button>
        <a asp-action="Users" class="btn btn-outline-secondary rounded-pill px-4">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
