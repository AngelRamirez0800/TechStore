@model RolePermissionsInput

@{
    ViewData["Title"] = $"Permisos - {Model.RoleName}";
    var isBuiltIn = ViewBag.IsBuiltIn is true || AppRoles.IsBuiltIn(Model.RoleName);
    var isAdminBuiltIn = string.Equals(Model.RoleName, AppRoles.Admin, StringComparison.OrdinalIgnoreCase);
    var permViewData = new ViewDataDictionary(ViewData)
    {
        ["LockAdminCorePermissions"] = isAdminBuiltIn
    };
}

<div class="rounded-4 shadow-sm text-white p-4 mb-4"
     style="background: linear-gradient(135deg, #1b263b 0%, #0077b6 100%);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge bg-light text-dark rounded-pill mb-2 px-3 py-1">
                <i class="bi bi-grid-3x3-gap me-1 text-primary"></i>Matriz de Permisos
            </span>
            <h1 class="h2 fw-bold mb-1">Permisos del rol: @Model.RoleName</h1>
            <p class="mb-0 text-white-50">
                Los cambios refrescan automáticamente la sesión de los usuarios asignados a este rol.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.RoleId" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-eye me-1"></i>Ver detalles
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>
</div>

<partial name="_AlertsPartial" />

@if (isBuiltIn)
{
    <div class="alert alert-info rounded-4 shadow-sm mb-4">
        <i class="bi bi-info-circle me-2"></i>
        Editando permisos del rol base <strong>@Model.RoleName</strong>.
        @if (isAdminBuiltIn)
        {
            <span>Los permisos <code>Roles.Manage</code> y <code>Users.Manage</code> son obligatorios para evitar bloqueo administrativo.</span>
        }
    </div>
}

<form asp-action="Permissions" asp-route-id="@Model.RoleId" method="post">
    <input type="hidden" asp-for="RoleId" />
    <input type="hidden" asp-for="RoleName" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 shadow-sm mb-4" role="alert"></div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <partial name="_PermissionGroups" model="Model.SelectedPermissions" view-data="permViewData" />
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #0077b6; border-color: #0077b6;">
            <i class="bi bi-check2-circle me-1"></i>Guardar permisos
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            Cancelar
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_PermissionGroupsScripts" />
}
