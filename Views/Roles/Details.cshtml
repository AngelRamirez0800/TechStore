@model RoleDetailsDto
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = $"Detalles del rol - {Model.Name}";
    var canManageUsers = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.UsersManage)).Succeeded;
    var grantedSet = Model.Permissions.ToHashSet(StringComparer.OrdinalIgnoreCase);
    var groupedCatalog = AppPermissions.All.GroupBy(p => p.Group).ToList();
}

<div class="rounded-4 shadow-sm text-white p-4 mb-4"
     style="background: linear-gradient(135deg, #1b263b 0%, #0077b6 100%);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                @if (Model.IsBuiltIn)
                {
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1">
                        <i class="bi bi-lock-fill me-1"></i>Rol base protegido
                    </span>
                }
                else
                {
                    <span class="badge bg-light text-dark rounded-pill px-3 py-1">
                        <i class="bi bi-tag me-1 text-primary"></i>Rol personalizado
                    </span>
                }
            </div>
            <h1 class="h2 fw-bold mb-1">@Model.Name</h1>
            <p class="mb-0 text-white-50">
                Resumen de permisos asignados y usuarios que pertenecen a este rol.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Permissions" asp-route-id="@Model.Id" class="btn btn-light text-primary fw-semibold rounded-pill px-4">
                <i class="bi bi-key me-1"></i>Permisos
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>
</div>

<partial name="_AlertsPartial" />

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <h5 class="fw-bold mb-3" style="color: #1b263b;">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Información del rol
                </h5>
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Nombre</dt>
                    <dd class="col-7 fw-semibold">@Model.Name</dd>

                    <dt class="col-5 text-muted">Tipo</dt>
                    <dd class="col-7">@(Model.IsBuiltIn ? "Rol base" : "Personalizado")</dd>

                    <dt class="col-5 text-muted">Permisos</dt>
                    <dd class="col-7">
                        <span class="badge rounded-pill text-white" style="background-color: #0077b6;">
                            @Model.Permissions.Count de @AppPermissions.All.Count
                        </span>
                    </dd>

                    <dt class="col-5 text-muted">Usuarios</dt>
                    <dd class="col-7">
                        <span class="badge bg-secondary rounded-pill">@Model.Users.Count</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="color: #1b263b;">
                        <i class="bi bi-shield-check me-2 text-primary"></i>Permisos agrupados
                    </h5>
                    <a asp-action="Permissions" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        Configurar matriz
                    </a>
                </div>

                @if (!Model.Permissions.Any())
                {
                    <div class="alert alert-warning rounded-3 mb-0">
                        <i class="bi bi-exclamation-circle me-1"></i>Este rol aún no tiene permisos asignados.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var group in groupedCatalog)
                        {
                            var activeInGroup = group.Where(p => grantedSet.Contains(p.Key)).ToList();
                            <div class="border rounded-3 p-3 bg-light bg-opacity-50">
                                <div class="fw-semibold mb-2" style="color: #1b263b;">
                                    @group.Key
                                    <span class="badge bg-white text-dark border rounded-pill ms-1">
                                        @activeInGroup.Count / @group.Count()
                                    </span>
                                </div>

                                @if (activeInGroup.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var perm in activeInGroup)
                                        {
                                            <span class="badge rounded-pill px-3 py-2 text-white"
                                                  style="background-color: #0077b6;"
                                                  title="@perm.Description">
                                                <i class="bi bi-check-circle-fill me-1"></i>@perm.Label
                                                <span class="opacity-75 ms-1">(@perm.Key)</span>
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Sin permisos en este módulo.</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center text-white"
         style="background-color: #1b263b;">
        <span class="fw-semibold">
            <i class="bi bi-people me-2"></i>Usuarios en este rol (@Model.Users.Count)
        </span>
        @if (canManageUsers)
        {
            <a asp-action="Users" class="btn btn-sm btn-outline-light rounded-pill px-3">
                Ver todos los usuarios
            </a>
        }
    </div>

    @if (!Model.Users.Any())
    {
        <div class="card-body">
            <div class="alert alert-secondary rounded-3 mb-0">
                <i class="bi bi-info-circle me-1"></i>No hay usuarios asignados actualmente a este rol.
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Usuario</th>
                        <th>Correo</th>
                        <th>Roles</th>
                        <th>Estado</th>
                        @if (canManageUsers)
                        {
                            <th class="pe-4 text-end">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@user.UserName</td>
                            <td>@user.Email</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var r in user.Roles)
                                    {
                                        var badgeColor = string.Equals(r, AppRoles.Admin, StringComparison.OrdinalIgnoreCase)
                                            ? "#1b263b"
                                            : "#0077b6";
                                        <span class="badge rounded-pill text-white" style="background-color: @badgeColor;">@r</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <span class="badge bg-danger rounded-pill px-3">Bloqueado</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3">Activo</span>
                                }
                            </td>
                            @if (canManageUsers)
                            {
                                <td class="pe-4 text-end">
                                    <a asp-action="AssignRoles"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-person-gear me-1"></i>Asignar roles
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
