@model IEnumerable<TechStore.Models.Category>
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Listado de Categorías";

    var canCreate = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.CategoriesCreate)).Succeeded;
    var canLifecycle = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.CategoriesLifecycle)).Succeeded;

    var visibleCategories = (Model ?? Enumerable.Empty<TechStore.Models.Category>())
        .Where(c => canLifecycle || c.IsActive)
        .OrderBy(c => c.Name)
        .ToList();

    var heroModel = new HeroBannerViewModel(
        title: "Categorías",
        subtitle: "Explora y organiza los productos tecnológicos de TechStore por línea de especialidad.",
        eyebrow: "Organización del Catálogo");
}

<partial name="_HeroBanner" model="heroModel" />

@if (canCreate)
{
    <div class="d-flex justify-content-end mb-4">
        <a class="btn btn-primary rounded-pill px-4" asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i>Agregar categoría
        </a>
    </div>
}

@if (!visibleCategories.Any())
{
    <div class="alert alert-info shadow-sm">
        <i class="bi bi-info-circle me-2"></i>
        No hay categorías registradas en este momento.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var categoria in visibleCategories)
        {
            <div class="col">
                <partial name="_CategoryCard" model="categoria" />
            </div>
        }
    </div>
}
