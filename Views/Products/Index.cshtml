@model List<TechStore.Models.Product>
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Productos";

    var canCreate = (await AuthorizationService.AuthorizeAsync(
        User, AppPermissions.ProductsCreate)).Succeeded;

    var canLifecycle = ViewBag.CanManageLifecycle is bool canManageLifecycle
        ? canManageLifecycle
        : (await AuthorizationService.AuthorizeAsync(
            User, AppPermissions.ProductsLifecycle)).Succeeded;

    var selectedCategoryIds = ViewBag.SelectedCategoryIds as IReadOnlySet<Guid>
        ?? new HashSet<Guid>();

    var selectedStatuses = ViewBag.SelectedStatuses as IReadOnlySet<string>
        ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    var filterCategories = (ViewBag.Categories as IEnumerable<TechStore.Models.Category>
        ?? Enumerable.Empty<TechStore.Models.Category>())
        .ToList();

    var selectedCategories = filterCategories
        .Where(c => selectedCategoryIds.Contains(c.Id))
        .ToList();

    var visibleProducts = Model ?? new List<TechStore.Models.Product>();

    var hasActiveFilters = selectedCategoryIds.Count > 0 ||
                           (canLifecycle && selectedStatuses.Count > 0);

    var filterBarModel = new CatalogFilterBarViewModel
    {
        ControllerName = "Products",
        ActionName = "Index",
        ButtonLabel = "Filtros",
        PrimaryGroupTitle = "Categorías",
        PrimaryParamName = "categoryIds",
        PrimaryEmptyMessage = "No hay categorías disponibles.",
        PrimaryOptions = filterCategories
            .Select(category => new CatalogFilterOption(
                category.Id,
                category.Name,
                selectedCategoryIds.Contains(category.Id),
                category.IsActive))
            .ToList(),
        ShowStatusFilter = canLifecycle,
        ActiveStatusLabel = "Activos",
        InactiveStatusLabel = "Inactivos",
        SelectedStatuses = selectedStatuses,
        ResultCount = visibleProducts.Count,
        ResultLabel = visibleProducts.Count == 1 ? "producto" : "productos"
    };

    var heroSubtitle = canCreate || canLifecycle
        ? "Administración del catálogo, existencias y precios de TechStore."
        : "Explora los dispositivos y accesorios tecnológicos disponibles en TechStore.";

    var heroModel = new HeroBannerViewModel(
        title: selectedCategories.Count == 1
            ? $"Productos · {selectedCategories[0].Name}"
            : "Productos",
        subtitle: heroSubtitle,
        eyebrow: null);
}

<partial name="_HeroBanner" model="heroModel" />

<!-- Encabezado y acciones del catálogo -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">

    <div>
        <p class="text-muted mb-0">
            Mostrando
            <strong>@visibleProducts.Count</strong>
            @(visibleProducts.Count == 1 ? "producto" : "productos")

            @if (selectedCategories.Count == 1)
            {
                <span>
                    en la categoría
                    <strong class="text-navy">@selectedCategories[0].Name</strong>
                </span>
            }
            else if (selectedCategories.Count > 1)
            {
                <span>
                    en
                    <strong class="text-navy">@selectedCategories.Count</strong>
                    categorías seleccionadas
                </span>
            }
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center">

        <!-- Exportar PDF -->
        <form asp-controller="ProductReports"
              asp-action="ExportPdf"
              method="get">

            @foreach (var categoryId in selectedCategoryIds)
            {
                <input type="hidden"
                       name="categoryIds"
                       value="@categoryId" />
            }

            @foreach (var status in selectedStatuses)
            {
                <input type="hidden"
                       name="statuses"
                       value="@status" />
            }

            <button type="submit"
                    class="btn btn-outline-danger rounded-pill px-3">
                <i class="bi bi-file-earmark-pdf me-1"></i>
                Exportar PDF
            </button>
        </form>

        <!-- Exportar Excel -->
        <form asp-controller="ProductReports"
              asp-action="ExportExcel"
              method="get">

            @foreach (var categoryId in selectedCategoryIds)
            {
                <input type="hidden"
                       name="categoryIds"
                       value="@categoryId" />
            }

            @foreach (var status in selectedStatuses)
            {
                <input type="hidden"
                       name="statuses"
                       value="@status" />
            }

            <button type="submit"
                    class="btn btn-outline-success rounded-pill px-3">
                <i class="bi bi-file-earmark-excel me-1"></i>
                Exportar Excel
            </button>
        </form>

        <!-- Crear producto -->
        @if (canCreate)
        {
            <a asp-controller="Products"
               asp-action="Create"
               class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-circle me-1"></i>
                Nuevo producto
            </a>
        }

    </div>
</div>

<!-- Barra de filtros -->
<div class="mb-4">
    <partial name="_CatalogFilterBar" model="filterBarModel" />
</div>

<!-- Productos -->
@if (!visibleProducts.Any())
{
    var emptyMessage = selectedCategories.Count == 1 && selectedStatuses.Count == 0
        ? $"No hay productos registrados en la categoría \"{selectedCategories[0].Name}\"."
        : hasActiveFilters
            ? "No hay productos que coincidan con los filtros seleccionados."
            : "No hay productos registrados.";

    <div class="alert alert-info shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2">

        <div>
            <i class="bi bi-info-circle me-2"></i>
            @emptyMessage
        </div>

        @if (hasActiveFilters)
        {
            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary rounded-pill">
                Ver todos los productos
            </a>
        }

    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var product in visibleProducts)
        {
            <div class="col">
                <partial name="_ProductCard" model="product" />
            </div>
        }

    </div>
}
