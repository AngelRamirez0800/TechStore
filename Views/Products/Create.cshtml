@model TechStore.Models.Product

@{
    ViewData["Title"] = "Crear nuevo producto";
    var categories = ViewBag.Categories as IEnumerable<TechStore.Models.Category>
        ?? Enumerable.Empty<TechStore.Models.Category>();
    var selectedCategoryIds = (ViewBag.SelectedCategoryIds as IEnumerable<Guid>)?.ToHashSet()
        ?? new HashSet<Guid>();

    var heroModel = new HeroBannerViewModel(
        title: "Crear nuevo producto",
        subtitle: "Registra un nuevo producto, asigna sus categorías y carga sus imágenes iniciales.",
        eyebrow: "Gestión de Productos");
}

<partial name="_HeroBanner" model="heroModel" />

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold">Nombre</label>
                    <input asp-for="Name" class="form-control" placeholder="Ej. Laptop Pro 15" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Price" class="form-label fw-semibold">Precio</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Stock" class="form-label fw-semibold">Existencias</label>
                    <input asp-for="Stock" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold">Descripción</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe las características principales del producto"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Categorías</label>
                    <select name="selectedCategoryIds" multiple class="form-select" size="5">
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@selectedCategoryIds.Contains(cat.Id)">
                                @cat.Name
                            </option>
                        }
                    </select>
                    <div class="form-text">Mantén Ctrl (o Cmd) para seleccionar múltiples categorías.</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Imágenes del producto</label>
                    <input type="file" name="images" multiple accept="image/*" class="form-control" />
                    <div class="form-text mb-3">Puedes seleccionar una o varias imágenes (PNG, JPG, WEBP).</div>

                    <div class="form-check mb-2">
                        <input asp-for="Featured" value="true" class="form-check-input" />
                        <label asp-for="Featured" class="form-check-label">Marcar como producto destacado</label>
                    </div>

                    <div class="form-check">
                        <input asp-for="IsActive" value="true" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label">Producto activo en catálogo</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-success rounded-pill px-4">
                    <i class="bi bi-check-circle me-1"></i>Crear producto
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
