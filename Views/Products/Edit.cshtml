@model TechStore.Models.Product

@{
    ViewData["Title"] = "Editar producto";

    var categories = ViewBag.Categories as IEnumerable<TechStore.Models.Category>
        ?? Enumerable.Empty<TechStore.Models.Category>();

    var selectedCategoryIds = (ViewBag.SelectedCategoryIds as IEnumerable<Guid>)?.ToHashSet()
        ?? Model.Categories?.Select(c => c.Id).ToHashSet()
        ?? new HashSet<Guid>();

    var imageUploadViewData = new ViewDataDictionary(ViewData)
    {
        ["ProductId"] = Model.Id,
        ["ImageUploadAction"] = "AddImages"
    };

    var heroModel = new HeroBannerViewModel(
        title: $"Editar producto · {Model.Name}",
        subtitle: "Actualiza los datos generales del producto y gestiona su galería de imágenes.",
        eyebrow: "Gestión de Productos");
}

<partial name="_HeroBanner" model="heroModel" />

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h2 class="h5 fw-bold text-navy mb-0">
            <i class="bi bi-pencil-square text-primary me-2"></i>Información del producto
        </h2>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold">Nombre</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Price" class="form-label fw-semibold">Precio</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Stock" class="form-label fw-semibold">Existencias</label>
                    <input asp-for="Stock" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold">Descripción</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Categorías</label>
                    <select name="selectedCategoryIds" multiple class="form-select" size="5">
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@selectedCategoryIds.Contains(cat.Id)">
                                @cat.Name
                            </option>
                        }
                    </select>
                    <div class="form-text">Mantén Ctrl (o Cmd) para seleccionar múltiples categorías.</div>
                </div>

                <div class="col-md-6 d-flex flex-column justify-content-center">
                    <div class="form-check mb-3">
                        <input asp-for="Featured" class="form-check-input" />
                        <label asp-for="Featured" class="form-check-label fw-semibold">Producto destacado</label>
                    </div>

                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Producto activo</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3 border-top flex-wrap">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-save me-1"></i>Guardar cambios
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4">
                    Ver detalle
                </a>
                <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                    Volver al listado
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h2 class="h5 fw-bold text-navy mb-0">
            <i class="bi bi-images text-primary me-2"></i>Galería e imágenes del producto
        </h2>
        <span class="badge rounded-pill bg-primary-subtle text-primary">
            @(Model.Images?.Count ?? 0) imagen(es)
        </span>
    </div>
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-lg-7">
                <partial name="_ProductImagesGallery" model="Model" />
            </div>
            <div class="col-lg-5">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body p-4">
                        <h3 class="h6 fw-bold text-navy mb-3">Agregar nuevas imágenes</h3>
                        <partial name="_ImageUpload" view-data="imageUploadViewData" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
