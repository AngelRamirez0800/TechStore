@model TechStore.Models.Product
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Detalles del Producto";

    var canEdit = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.ProductsEdit)).Succeeded;
    var canLifecycle = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.ProductsLifecycle)).Succeeded;
    var canReadCategories = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.CategoriesRead)).Succeeded;

    var galleryViewData = new ViewDataDictionary(ViewData)
    {
        ["AllowImageDelete"] = false
    };

    var heroModel = new HeroBannerViewModel(
        title: Model.Name,
        subtitle: "Consulta las especificaciones, existencias y categorías asociadas de este producto.",
        eyebrow: "Ficha del Producto");
}

<partial name="_HeroBanner" model="heroModel" />

<div class="row g-4">
    <div class="col-lg-5">
        <partial name="_ProductImagesGallery" model="Model" view-data="galleryViewData" />
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <h2 class="h3 fw-bold text-uppercase text-navy mb-0">@Model.Name</h2>
                    <vc:stock-badge stock="@Model.Stock" is-active="@Model.IsActive" />
                </div>

                <p class="text-muted mb-4">@Model.Description</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Precio</dt>
                    <dd class="col-sm-8 fw-bold fs-4 text-primary">@Model.Price.ToString("C2")</dd>

                    <dt class="col-sm-4 text-muted">Stock</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Stock unidades</dd>

                    <dt class="col-sm-4 text-muted">Destacado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Featured)
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-star-fill me-1"></i>Sí
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No</span>
                        }
                    </dd>

                    @if (canLifecycle)
                    {
                        <dt class="col-sm-4 text-muted">Estado</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </dd>
                    }

                    <dt class="col-sm-4 text-muted">Categorías</dt>
                    <dd class="col-sm-8">
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var cat in Model.Categories.OrderBy(c => c.Name))
                                {
                                    if (canReadCategories)
                                    {
                                        <a asp-controller="Category"
                                           asp-action="Details"
                                           asp-route-id="@cat.Id"
                                           class="badge bg-primary text-decoration-none">
                                            @cat.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">@cat.Name</span>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Sin categorías</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-4 flex-wrap">
    @if (canEdit)
    {
        <a class="btn btn-primary rounded-pill px-4"
           asp-action="Edit"
           asp-route-id="@Model.Id">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
    }

    <a class="btn btn-outline-primary rounded-pill px-4"
       asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>Volver al catálogo
    </a>

    @if (canLifecycle)
    {
        @if (Model.IsActive)
        {
            <form asp-action="Deactivate"
                  method="post"
                  asp-route-id="@Model.Id"
                  class="d-inline swal-delete-form"
                  data-swal-title="¿Desactivar producto?"
                  data-swal-text="El producto dejará de mostrarse en el catálogo público."
                  data-swal-confirm="Sí, desactivar">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger rounded-pill px-4">
                    <i class="bi bi-x-circle me-1"></i>Desactivar
                </button>
            </form>
        }
        else
        {
            <form asp-action="Restore"
                  method="post"
                  asp-route-id="@Model.Id"
                  class="d-inline swal-confirm-form"
                  data-swal-title="¿Reactivar producto?"
                  data-swal-text="El producto volverá a mostrarse como activo."
                  data-swal-confirm="Sí, reactivar"
                  data-swal-color="#198754">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success rounded-pill px-4">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reactivar
                </button>
            </form>
        }
    }
</div>
