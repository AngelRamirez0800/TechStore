@model TechStore.Models.ContactoViewModel
@{
    ViewData["Title"] = "Contáctenos";
    var heroModel = new HeroBannerViewModel(
        title: "Contáctenos",
        subtitle: "¿Tienes dudas sobre algún producto o pedido? Escríbenos y nuestro equipo te responderá pronto.",
        eyebrow: null);
}

<partial name="_HeroBanner" model="heroModel" />

<partial name="_AlertsPartial" />

<div class="row g-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Contacto" asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label fw-semibold"></label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Tu nombre completo" />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold"></label>
                        <input asp-for="Correo" class="form-control" placeholder="tucorreo@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Asunto" class="form-label fw-semibold"></label>
                        <input asp-for="Asunto" class="form-control" placeholder="Asunto de tu mensaje" />
                        <span asp-validation-for="Asunto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mensaje" class="form-label fw-semibold"></label>
                        <textarea asp-for="Mensaje" class="form-control" rows="5" placeholder="Escribe tu mensaje..."></textarea>
                        <span asp-validation-for="Mensaje" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-send me-1"></i>Enviar mensaje
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card bg-light border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold text-navy mb-3">
                    <i class="bi bi-headset text-primary me-2"></i>Información de contacto
                </h5>
                <p class="card-text mb-3"><i class="bi bi-geo-alt text-primary me-2"></i> San Salvador, El Salvador</p>
                <p class="card-text mb-3"><i class="bi bi-telephone text-primary me-2"></i> +503 2222-3333</p>
                <p class="card-text mb-3"><i class="bi bi-envelope text-primary me-2"></i> contacto@techstore.com</p>
                <p class="card-text mb-0"><i class="bi bi-clock text-primary me-2"></i> Lunes a Viernes, 8:00 am - 5:00 pm</p>
            </div>
        </div>
    </div>
</div>

<br />
<br />
<br />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
