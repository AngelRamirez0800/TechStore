@model List<TechStore.Models.Product>
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Inicio";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var canReadProducts = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, AppPermissions.ProductsRead)).Succeeded;
    var canReadCategories = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, AppPermissions.CategoriesRead)).Succeeded;

    var heroModel = canReadProducts
        ? new HeroBannerViewModel(
            title: "Bienvenido a TechStore",
            subtitle: "Tu tienda de confianza en tecnología: laptops, smartphones, audio y accesorios al mejor precio, con la calidad que buscas.",
            eyebrow: null,
            ctaText: "Ver productos",
            ctaController: "Products",
            ctaAction: "Index")
        : new HeroBannerViewModel(
            title: "Bienvenido a TechStore",
            subtitle: "Tu tienda de confianza en tecnología: laptops, smartphones, audio y accesorios al mejor precio, con la calidad que buscas.",
            eyebrow: null,
            ctaText: isAuthenticated ? "Contáctenos" : "Iniciar sesión",
            ctaController: isAuthenticated ? "Contacto" : "Account",
            ctaAction: isAuthenticated ? "Index" : "Login");
}

<partial name="_HeroBanner" model="heroModel" />

@if (!isAuthenticated)
{
    <div class="card border-0 shadow-sm guest-cta-card mb-4">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="h5 fw-bold text-navy mb-1">
                    <i class="bi bi-compass text-primary me-2"></i>Inicia sesión para explorar el catálogo completo
                </h2>
                <p class="text-muted mb-0 small">
                    Accede al inventario actualizado por categorías, disponibilidad en tiempo real y fichas detalladas de cada equipo.
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-person-plus me-1"></i>Crear cuenta
                </a>
            </div>
        </div>
    </div>
}

<hr />

<div class="iconos-inicio row text-center mb-5 g-3 justify-content-center">
    @if (canReadProducts)
    {
        <div class="col-6 col-md-3">
            <a asp-controller="Products"
               asp-action="Index"
               class="card quick-link-card h-100 border-0 shadow-sm p-3 text-decoration-none text-dark">
                <i class="bi bi-box-seam display-6 text-primary"></i>
                <p class="mt-2 mb-0 fw-bolder">Productos</p>
            </a>
        </div>
    }
    else if (!isAuthenticated)
    {
        <div class="col-6 col-md-3">
            <a asp-controller="Account"
               asp-action="Login"
               class="card quick-link-card h-100 border-0 shadow-sm p-3 text-decoration-none text-dark">
                <i class="bi bi-box-arrow-in-right display-6 text-primary"></i>
                <p class="mt-2 mb-0 fw-bolder">Iniciar sesión</p>
            </a>
        </div>
    }

    @if (canReadCategories)
    {
        <div class="col-6 col-md-3">
            <a asp-controller="Category"
               asp-action="Index"
               class="card quick-link-card h-100 border-0 shadow-sm p-3 text-decoration-none text-dark">
                <i class="bi bi-grid display-6 text-primary"></i>
                <p class="mt-2 mb-0 fw-bolder">Categorías</p>
            </a>
        </div>
    }
    else if (!isAuthenticated)
    {
        <div class="col-6 col-md-3">
            <a asp-controller="Account"
               asp-action="Register"
               class="card quick-link-card h-100 border-0 shadow-sm p-3 text-decoration-none text-dark">
                <i class="bi bi-person-plus display-6 text-primary"></i>
                <p class="mt-2 mb-0 fw-bolder">Crear cuenta</p>
            </a>
        </div>
    }

    <div class="col-6 col-md-3">
        <a asp-controller="Contacto"
           asp-action="Index"
           class="card quick-link-card h-100 border-0 shadow-sm p-3 text-decoration-none text-dark">
            <i class="bi bi-envelope display-6 text-primary"></i>
            <p class="mt-2 mb-0 fw-bolder">Contáctenos</p>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a asp-controller="About"
           asp-action="Index"
           class="card quick-link-card h-100 border-0 shadow-sm p-3 text-decoration-none text-dark">
            <i class="bi bi-info-circle display-6 text-primary"></i>
            <p class="mt-2 mb-0 fw-bolder">Nosotros</p>
        </a>
    </div>
</div>

<hr />

<div class="productos-texto-inicio mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="text-navy fw-bold mb-0">Productos Destacados</h2>

    @if (canReadProducts)
    {
        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-primary btn-sm rounded-pill px-3">
            Ver todos <i class="bi bi-arrow-right ms-1"></i>
        </a>
    }
    else if (!isAuthenticated)
    {
        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-outline-primary btn-sm rounded-pill px-3">
            Inicia sesión para ver el catálogo <i class="bi bi-lock ms-1"></i>
        </a>
    }
</div>

@if (Model != null && Model.Any())
{
    var featuredList = Model.ToList();
    <div id="featuredProductsCarousel"
         class="featured-products-carousel carousel slide rounded-4 overflow-hidden shadow-sm"
         data-bs-ride="carousel">

        @if (featuredList.Count > 1)
        {
            <div class="carousel-indicators">
                @for (var i = 0; i < featuredList.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#featuredProductsCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : string.Empty)"
                            aria-current="@(i == 0 ? "true" : "false")"
                            aria-label="Producto destacado @(i + 1)"></button>
                }
            </div>
        }

        <div class="carousel-inner">
            @for (var i = 0; i < featuredList.Count; i++)
            {
                var product = featuredList[i];
                var primaryImage = product.Images?.OrderBy(img => img.ImageNumber).FirstOrDefault();
                var imagePath = primaryImage != null
                    ? Url.Content("~/" + primaryImage.ImagePath.TrimStart('/'))
                    : Url.Content("~/Images/Componentes/logo.png");
                var primaryCategory = product.Categories?
                    .Where(c => c.IsActive)
                    .OrderBy(c => c.Name)
                    .FirstOrDefault()?.Name;

                <div class="carousel-item @(i == 0 ? "active" : string.Empty)">
                    <a asp-controller="Products"
                       asp-action="Index"
                       class="featured-banner-link d-block text-decoration-none text-white"
                       aria-label="Explorar @product.Name en Productos">
                        <div class="featured-banner-slide p-4 p-md-5 d-flex align-items-center">
                            <div class="row w-100 align-items-center g-4 mx-0">
                                <div class="col-12 col-md-7 text-start">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-semibold">
                                            <i class="bi bi-star-fill me-1"></i>Destacado
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(primaryCategory))
                                        {
                                            <span class="badge bg-light text-dark rounded-pill px-3 py-1">
                                                @primaryCategory
                                            </span>
                                        }
                                    </div>

                                    <h3 class="display-6 fw-bold text-white mb-2">@product.Name</h3>

                                    @if (!string.IsNullOrWhiteSpace(product.Description))
                                    {
                                        var summary = product.Description.Length > 140
                                            ? product.Description[..137] + "..."
                                            : product.Description;
                                        <p class="text-white-75 mb-3">@summary</p>
                                    }

                                    <div class="d-flex flex-wrap align-items-center gap-3">
                                        <span class="fs-4 fw-bold text-white">$@product.Price.ToString("N2")</span>
                                        <span class="btn btn-light btn-sm rounded-pill px-3 fw-semibold text-primary shadow-sm">
                                            Ver en Productos <i class="bi bi-arrow-right ms-1"></i>
                                        </span>
                                    </div>
                                </div>

                                <div class="col-12 col-md-5">
                                    <div class="featured-banner-img-wrap shadow-sm">
                                        <img src="@imagePath"
                                             alt="@product.Name"
                                             class="featured-banner-img" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @if (featuredList.Count > 1)
        {
            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#featuredProductsCarousel"
                    data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>

            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#featuredProductsCarousel"
                    data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        }
    </div>
}
else
{
    <div class="alert alert-info shadow-sm">
        <i class="bi bi-info-circle me-2"></i>
        No hay productos destacados disponibles.
    </div>
}

<div id="carouselExample"
     class="carrusel-anuncio carousel slide rounded-4 overflow-hidden shadow-sm"
     data-bs-ride="carousel">

    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="~/Images/Anuncios/AnuncioAudifonos.jpg"
                 class="d-block w-100"
                 alt="Anuncio de audífonos">
        </div>

        <div class="carousel-item">
            <img src="~/Images/Anuncios/AnuncioTeclado.jpg"
                 class="d-block w-100"
                 alt="Anuncio de teclado">
        </div>

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#carouselExample"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#carouselExample"
            data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>

</div>
