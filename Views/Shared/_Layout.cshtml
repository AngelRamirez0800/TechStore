@inject IAuthorizationService AuthorizationService

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TechStore</title>

    <link rel="icon" type="image/png" href="~/Images/Componentes/IMG_0714.png" />

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TechStore.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg border-bottom box-shadow mb-3 techstore-navbar"
             style="background-color: #DEE9FF;"
             data-bs-theme="light">

            <div class="container-fluid px-lg-4">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-navy"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/Images/Componentes/IMG_0714.png"
                         alt="Mascota TechStore"
                         class="techstore-nav-mascot" />
                    <span>TechStore</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Mostrar u ocultar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse justify-content-between align-items-lg-center">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link text-dark btn"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Inicio
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var canReadProducts = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.ProductsRead)).Succeeded;
                            var canReadCategories = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.CategoriesRead)).Succeeded;

                            @if (canReadProducts)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark btn"
                                       asp-area=""
                                       asp-controller="Products"
                                       asp-action="Index">
                                        <i class="bi bi-box-seam me-1"></i>Productos
                                    </a>
                                </li>
                            }

                            @if (canReadCategories)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark btn"
                                       asp-area=""
                                       asp-controller="Category"
                                       asp-action="Index">
                                        <i class="bi bi-grid me-1"></i>Categorías
                                    </a>
                                </li>
                            }

                            @if (canReadProducts)
                            {
                                <vc:category-menu />
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark btn"
                               asp-area=""
                               asp-controller="Contacto"
                               asp-action="Index">
                                <i class="bi bi-envelope me-1"></i>Contáctenos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark btn"
                               asp-area=""
                               asp-controller="About"
                               asp-action="Index">
                                <i class="bi bi-info-circle me-1"></i>Acerca de nosotros
                            </a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            <partial name="_AlertsPartial" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto bg-light">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small">
            <span class="fw-medium text-dark">
                <img src="~/Images/Componentes/IMG_0714.png"
                     alt="Mascota TechStore"
                     class="techstore-footer-mascot me-2" />
                &copy; 2026 - TechStore. Todos los derechos reservados.
            </span>

            <div class="d-flex flex-wrap align-items-center justify-content-center gap-3">
                <a class="text-decoration-none text-muted" asp-controller="About" asp-action="Index">Acerca de nosotros</a>
                <a class="text-decoration-none text-muted" asp-controller="Contacto" asp-action="Index">Contáctenos</a>
                <span>
                    <i class="bi bi-envelope text-primary me-1"></i>contacto@techstore.com
                </span>
                <span>
                    <i class="bi bi-telephone text-primary me-1"></i>+503 2222-3333
                </span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
