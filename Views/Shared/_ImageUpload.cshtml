@{
    var action = ViewData["ImageUploadAction"] as string ?? "AddImages";
    object? pidObj = ViewData["ProductId"];
    Guid? productId = null;
    if (pidObj is Guid g)
    {
        productId = g;
    }
    else if (pidObj is string s && Guid.TryParse(s, out var gp))
    {
        productId = gp;
    }
}

<form asp-action="@action" asp-controller="Products" method="post" enctype="multipart/form-data" class="image-upload-form">
    @Html.AntiForgeryToken()
    @if (productId != null)
    {
        <input type="hidden" name="id" value="@productId" />
    }

    <div class="mb-3">
        <label for="images" class="form-label fw-semibold">
            <i class="bi bi-cloud-arrow-up text-primary me-1"></i>Seleccionar imágenes adicionales
        </label>
        <input type="file" id="images" name="images" multiple accept="image/*" class="form-control" />
        <div class="form-text">Puedes seleccionar una o varias imágenes (PNG, JPG, JPEG, WEBP, GIF).</div>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-2">
        <button type="submit" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-upload me-1"></i>Subir imágenes
        </button>
        <small id="images-count" class="text-muted fw-semibold"></small>
    </div>
</form>

<script>
    (function () {
        var input = document.getElementById('images');
        var counter = document.getElementById('images-count');
        if (!input || !counter) return;
        input.addEventListener('change', function () {
            var n = input.files ? input.files.length : 0;
            counter.textContent = n > 0 ? n + ' archivo(s) seleccionado(s)' : '';
        });
    })();
</script>
