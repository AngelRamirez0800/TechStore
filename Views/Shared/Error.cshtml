@model object?
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var resolvedModel = Model as TechStore.Models.ErrorDetailsViewModel;

    if (resolvedModel is null)
    {
        var legacy = Model as TechStore.Models.ErrorViewModel;
        resolvedModel = new TechStore.Models.ErrorDetailsViewModel
        {
            StatusCode = 500,
            Title = "Error interno del servidor",
            Message = "Ocurrió un problema inesperado al procesar tu solicitud. Puedes volver al inicio o compartir el código de seguimiento con soporte.",
            RequestId = legacy?.RequestId ?? Context.TraceIdentifier,
            ShowDiagnostics = HostEnvironment.IsDevelopment()
        };
    }

    ViewData["Title"] = $"{resolvedModel.StatusCode} - {resolvedModel.Title}";
}

<partial name="~/Views/Error/StatusCode.cshtml" model="resolvedModel" />
