@model TechStore.Models.Category
@inject IAuthorizationService AuthorizationService

@{
    var canEdit = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.CategoriesEdit)).Succeeded;
    var canLifecycle = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.CategoriesLifecycle)).Succeeded;
    var canReadProducts = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.ProductsRead)).Succeeded;
    var canLifecycleProducts = (await AuthorizationService.AuthorizeAsync(User, AppPermissions.ProductsLifecycle)).Succeeded;

    var productCount = Model.Products == null
        ? 0
        : canLifecycleProducts
            ? Model.Products.Count
            : Model.Products.Count(p => p.IsActive);
}

<div class="card category-card h-100 border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-start gap-2">
        <h5 class="card-title fw-bold mb-0 text-navy">
            <i class="bi bi-tag text-primary me-1"></i>@Model.Name
        </h5>

        @if (canLifecycle)
        {
            @if (Model.IsActive)
            {
                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                    Activa
                </span>
            }
            else
            {
                <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle">
                    Inactiva
                </span>
            }
        }
        else if (Model.IsActive)
        {
            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">
                Activa
            </span>
        }
    </div>

    <div class="card-body d-flex flex-column">
        <p class="card-text text-muted small flex-grow-1 mb-3">
            @Model.Description
        </p>

        <div class="d-flex align-items-center justify-content-between text-muted small mb-3 pt-2 border-top">
            <span>
                <i class="bi bi-box-seam text-primary me-1"></i>
                <strong>@productCount</strong> @(productCount == 1 ? "producto" : "productos")
            </span>
            <span>
                <i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("dd/MM/yyyy")
            </span>
        </div>

        <div class="d-grid gap-2">
            <div class="d-flex gap-2">
                <a asp-controller="Category"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary btn-sm flex-grow-1">
                    <i class="bi bi-eye me-1"></i>Ver detalle
                </a>

                @if (canReadProducts)
                {
                    <a href="@Url.Action("Index", "Products", new { categoryId = Model.Id })"
                       class="btn btn-outline-secondary btn-sm flex-grow-1">
                        <i class="bi bi-grid me-1"></i>Productos
                    </a>
                }
            </div>

            @if (canEdit || canLifecycle)
            {
                <div class="d-flex gap-2">
                    @if (canEdit)
                    {
                        <a asp-controller="Category"
                           asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                    }

                    @if (canLifecycle)
                    {
                        @if (Model.IsActive)
                        {
                            <form asp-controller="Category"
                                  asp-action="Deactivate"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="flex-grow-1 swal-delete-form"
                                  data-swal-title="¿Desactivar categoría?"
                                  data-swal-text="Si no tiene productos asociados, la categoría quedará inactiva."
                                  data-swal-confirm="Sí, desactivar">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                    <i class="bi bi-x-circle me-1"></i>Desactivar
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Category"
                                  asp-action="Restore"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="flex-grow-1 swal-confirm-form"
                                  data-swal-title="¿Reactivar categoría?"
                                  data-swal-text="La categoría volverá a estar activa en el catálogo."
                                  data-swal-confirm="Sí, reactivar"
                                  data-swal-color="#198754">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-success btn-sm w-100">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reactivar
                                </button>
                            </form>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>
