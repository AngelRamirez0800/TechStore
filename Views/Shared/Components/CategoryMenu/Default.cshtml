@model IEnumerable<TechStore.Models.Category>

@{
    var categories = Model?.ToList() ?? new List<TechStore.Models.Category>();
    Guid.TryParse(Context.Request.Query["categoryId"], out var selectedCategoryId);
}

<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle text-dark btn"
       href="#"
       id="categoryMenuDropdown"
       role="button"
       data-bs-toggle="dropdown"
       aria-expanded="false">
        <i class="bi bi-tags me-1"></i>Explorar categorías
    </a>
    <ul class="dropdown-menu techstore-dropdown shadow-sm border-0" aria-labelledby="categoryMenuDropdown">
        <li>
            <a class="dropdown-item d-flex justify-content-between align-items-center @(selectedCategoryId == Guid.Empty && string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Products", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
               asp-controller="Products"
               asp-action="Index">
                <span><i class="bi bi-grid-3x3-gap me-2"></i>Todos los productos</span>
            </a>
        </li>
        @if (categories.Any())
        {
            <li><hr class="dropdown-divider" /></li>
            @foreach (var category in categories)
            {
                var activeProductCount = category.Products?.Count(p => p.IsActive) ?? 0;
                var isSelected = selectedCategoryId == category.Id;
                <li>
                    <a class="dropdown-item d-flex justify-content-between align-items-center gap-3 @(isSelected ? "active" : string.Empty)"
                       href="@Url.Action("Index", "Products", new { categoryId = category.Id })">
                        <span>@category.Name</span>
                        <span class="badge rounded-pill @(isSelected ? "bg-light text-primary" : "bg-primary-subtle text-primary")">
                            @activeProductCount
                        </span>
                    </a>
                </li>
            }
        }
        else
        {
            <li><hr class="dropdown-divider" /></li>
            <li>
                <span class="dropdown-item-text text-muted small">Sin categorías activas</span>
            </li>
        }
    </ul>
</li>
